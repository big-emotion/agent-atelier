{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idea.json",
  "description": "Machine form of the subject report written by the idea step.",
  "type": "object",
  "required": ["question", "angle", "promise", "audience", "hook", "wontSay", "sources", "reservations", "formats", "networks", "basis", "basisReason"],
  "properties": {
    "question": { "type": "string", "description": "One bounded question the sources can answer honestly." },
    "angle": { "type": "string" },
    "promise": { "type": "string", "description": "Exactly one sentence." },
    "audience": { "type": "string" },
    "hook": {
      "type": "object",
      "required": ["text", "payoff"],
      "properties": {
        "text": { "type": "string" },
        "payoff": { "type": "string", "description": "Where the sources pay the hook off. A hook with no payoff is bait." }
      }
    },
    "wontSay": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "supports"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "supports": { "type": "string" }
        }
      }
    },
    "reservations": { "type": "array", "items": { "type": "string" } },
    "formats": { "type": "array", "minItems": 1, "items": { "enum": ["carousel", "reel", "image"] } },
    "networks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "basis": { "enum": ["dated-evidence", "exploratory"] },
    "basisReason": { "type": "string", "description": "For dated-evidence: the date (YYYY-MM-DD) of the audience report. For exploratory: why no comparable exists." }
  }
}
